  "narrative": {
    "northStar": "The familiar internship desk",
    "overview": "A quiet local workspace for scanning roles, inspecting their evidence and returning to the list. Warm neutral surroundings, white working surfaces and restrained orange actions carry the existing Career-ops visual vocabulary into familiar browser controls. Precision and readable density supply the character.\n\nThis document applies only to `career-ops/local/discovery/web`. The visual authority is the implemented `index.html`, `style.css` and `app.js`, checked against the desktop and mobile review captures. It inherits the warm background, white surfaces, orange action family and dark action text from [the upstream Career-ops stylesheet](../../../web/src/app/globals.css). Local literals are the source of truth for this surface; they do not redefine the upstream system. The local system uses Windows system UI type and a light theme. It does not import the upstream marketing serif, olive landing treatment, dark theme or decorative animation.",
    "keyCharacteristics": [
      "Flat, bounded working surfaces with thin warm dividers.",
      "Strong role titles, tabular scores and quiet supporting evidence.",
      "Orange for primary actions, current selection and keyboard focus.",
      "Explicit text for source state, uncertainty and incomplete data.",
      "A simultaneous desktop list/detail view and a mobile list-to-detail path."
    ],
    "rules": [
      {
        "name": "The Action Ink Rule",
        "body": "Keep the dark foreground on orange primary actions; use the deep orange accent for small action text.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Status color accompanies a readable label or message. Green is an observed positive signal; amber retains an unresolved question.",
        "section": "colors"
      },
      {
        "name": "The Reading Floor Rule",
        "body": "Preserve the implemented 12px metadata floor. Do not allow browser-default `small` sizing to shrink source timestamps below it.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the inherited warm neutral/orange vocabulary and the local surface's system UI type.",
      "**Do** keep titles, scores, source evidence and unresolved requirements easy to distinguish.",
      "**Do** retain the 12px metadata floor, wrapping long content and visible keyboard focus.",
      "**Do** preserve list/detail behavior and the mobile back path when adding related states.",
      "**Do** show partial source failure while keeping saved results readable."
    ],
    "donts": [
      "**Don't** redefine the upstream Career-ops system from this isolated local document.",
      "**Don't** add a marketing identity, decorative typography, shadows or unrelated animation to this task workspace.",
      "**Don't** use color alone to imply verification or turn a fit score into a hiring probability.",
      "**Don't** erase excluded records, missing evidence or uncertainty to make the result list look cleaner.",
      "**Don't** add application submission, outreach, resume upload or scheduling controls to the discovery interface."
    ]

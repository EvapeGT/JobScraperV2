  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Refresh listings or open the original listing; dark type on the inherited orange.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M16.5 8A6.7 6.7 0 1 0 16 14M16.5 3v5h-5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Refresh listings</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;font-size:14px;font-weight:650;background:var(--brand,#dd7627);color:var(--brand-ink,#281c15);padding:12px 18px;border:0;border-radius:var(--radius,8px);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;white-space:nowrap;transition:background-color 160ms ease,color 160ms ease;}.ds-primary svg{width:20px;height:20px;flex-shrink:0}.ds-primary:hover:not(:disabled){background:var(--brand-hover,#ff9f33)}.ds-primary:focus-visible{outline:2px solid var(--accent,#a65012);outline-offset:3px;}.ds-primary:disabled{cursor:wait;opacity:.65}.ds-primary.ds-refreshing svg{animation:ds-rotate 1.4s linear infinite}@keyframes ds-rotate{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary.ds-refreshing svg{animation:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Compact underlined action for clearing filters.",
      "html": "<button class=\"ds-text\">Clear filters</button>",
      "css": ".ds-text{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;font-size:12px;background:transparent;border:0;color:var(--accent,#a65012);padding:4px 0;text-decoration:underline;text-underline-offset:3px;cursor:pointer;transition:background-color 160ms ease,color 160ms ease;}.ds-text:focus-visible{outline:2px solid var(--accent,#a65012);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Labeled search with a familiar icon and focus on the field container.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"m13 13 4 4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg><input type=\"search\" aria-label=\"Search roles, companies and skills\" placeholder=\"Search roles, companies, skills…\"></label>",
      "css": ".ds-search{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:flex;align-items:center;gap:8px;border:1px solid var(--line,#dedbd4);border-radius:6px;background:var(--surface,#fff);padding:9px 10px;min-width:190px;color:var(--muted,#625c53)}.ds-search svg{width:20px;height:20px;flex-shrink:0}.ds-search input{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;font-size:13px;width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--ink,#1f1c19);caret-color:var(--accent,#a65012)}.ds-search input::placeholder{color:var(--muted,#625c53)}.ds-search:focus-within{outline:2px solid var(--accent,#a65012);outline-offset:1px}.ds-search input:focus-visible{outline:0}"
    },
    {
      "name": "Native select",
      "kind": "input",
      "refersTo": "select",
      "description": "Visible label and native select for view, source or sort.",
      "html": "<label class=\"ds-select\"><span>Show</span><select><option>Ranked leads</option><option>Needs review</option><option>All records</option><option>Excluded</option></select></label>",
      "css": ".ds-select{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted,#625c53)}.ds-select select{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;min-height:38px;border:1px solid var(--line,#dedbd4);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#1f1c19);padding:7px;max-width:180px;font-size:12px}.ds-select select:focus-visible{outline:2px solid var(--accent,#a65012);outline-offset:3px;}"
    },
    {
      "name": "Track navigation",
      "kind": "nav",
      "refersTo": "track-tab",
      "description": "Pressed track uses deep orange text and a bottom rule; counts follow the other active filters.",
      "html": "<div class=\"ds-tracks\" role=\"group\" aria-label=\"Filter by career track\"><button aria-pressed=\"true\">All tracks <span>32</span></button><button aria-pressed=\"false\">Java / Backend <span>20</span></button></div>",
      "css": ".ds-tracks{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:flex;gap:24px;flex-wrap:wrap}.ds-tracks button{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;font-size:14px;min-height:59px;padding:10px 0;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted,#625c53);font-weight:550;white-space:nowrap;cursor:pointer;transition:background-color 160ms ease,color 160ms ease;}.ds-tracks button:hover{color:var(--ink,#1f1c19)}.ds-tracks button[aria-pressed=true]{border-bottom-color:var(--accent,#a65012);color:var(--accent,#a65012)}.ds-tracks button:focus-visible{outline:2px solid var(--accent,#a65012);outline-offset:3px;}.ds-tracks span{font-size:12px;display:inline-block;font-variant-numeric:tabular-nums;margin-left:4px;font-weight:400}@media(max-width:760px){.ds-tracks{gap:20px;overflow-x:auto;flex-wrap:nowrap}.ds-tracks button{min-height:52px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-tracks button{transition:none}}"
    },
    {
      "name": "Neutral evidence tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Noninteractive track or source-count label.",
      "html": "<span class=\"ds-tag\">Java / Backend</span>",
      "css": ".ds-tag{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;border:1px solid var(--line,#dedbd4);padding:3px 7px;border-radius:4px;font-size:12px;color:var(--muted,#625c53);line-height:1.5}"
    },
    {
      "name": "Review evidence tag",
      "kind": "chip",
      "refersTo": "tag-review",
      "description": "Explicit uncertainty, exclusion or possible-duplicate label.",
      "html": "<span class=\"ds-tag-review\">Needs review</span>",
      "css": ".ds-tag-review{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;border:1px solid #decca0;padding:3px 7px;border-radius:4px;font-size:12px;color:var(--warning,#79520b);background:var(--warning-bg,#fbf5e8);line-height:1.5}"
    },
    {
      "name": "Positive evidence tag",
      "kind": "chip",
      "refersTo": "tag-positive",
      "description": "Explicit Spring Boot mention; a positive observed signal.",
      "html": "<span class=\"ds-tag-positive\">Spring Boot</span>",
      "css": ".ds-tag-positive{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:inline-flex;align-items:center;border:1px solid #bdd1c4;padding:3px 7px;border-radius:4px;font-size:12px;color:var(--success,#2f6149);background:#f1f7f3;line-height:1.5}"
    },
    {
      "name": "Selected result row",
      "kind": "custom",
      "refersTo": "job-row",
      "description": "Full-row selection target; title, employer and score remain distinct.",
      "html": "<button class=\"ds-row\" aria-current=\"true\" aria-label=\"Backend Developer Intern at ELI IT SOLUTIONS, fit score 97 of 100\"><span class=\"ds-row-top\"><span class=\"ds-company\">ELI IT SOLUTIONS</span><span class=\"ds-score\">97 <small>/ 100</small></span></span><span class=\"ds-row-title\">Backend Developer Intern</span><span class=\"ds-location\">Valenzuela, P00, Philippines</span><span class=\"ds-row-meta\"><span class=\"ds-row-tag\">Java / Backend</span></span></button>",
      "css": ".ds-row{font-family:\"Segoe UI\",system-ui,-apple-system,sans-serif;display:block;text-align:left;width:100%;padding:19px 20px;border:0;border-bottom:1px solid var(--line,#dedbd4);position:relative;background:var(--surface,#fff);color:var(--ink,#1f1c19);cursor:pointer;transition:background-color 160ms ease,color 160ms ease;}.ds-row:hover{background:#faf9f6}.ds-row[aria-current=true]{background:var(--selected,#fbf1e7)}.ds-row[aria-current=true] .ds-row-title{color:var(--accent,#a65012)}.ds-row:focus-visible{outline:2px solid var(--accent,#a65012);outline-offset:3px;}.ds-row-top{display:flex;justify-content:space-between;gap:16px;align-items:baseline}.ds-company{font-size:12px;font-weight:550;overflow-wrap:anywhere;color:var(--muted,#625c53)}.ds-score{font-size:14px;font-weight:650;font-variant-numeric:tabular-nums;flex-shrink:0}.ds-score small{font-size:12px;font-weight:400;color:var(--muted,#625c53)}.ds-row-title{display:block;font-weight:650;font-size:15px;line-height:1.45;margin:7px 0 6px;overflow-wrap:anywhere}.ds-location{color:var(--muted,#625c53);font-size:12px;line-height:1.5}.ds-row-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.ds-row-tag{display:inline-flex;align-items:center;border:1px solid var(--line,#dedbd4);padding:3px 7px;border-radius:4px;font-size:12px;color:var(--muted,#625c53);line-height:1.5}@media(max-width:760px){.ds-row{padding:18px}}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
